@model List<FutbolAnalizPazari.Models.Basvurular>
@using FutbolAnalizPazari.Models
@inject AnalizPlatformuContext _context

@{
    ViewData["Title"] = "Gelen Başvurular";
}

<div class="container mt-5">

    <div class="mb-4">
        <h4 class="text-muted">Maç: @ViewBag.MacBasligi</h4>
        <h2 class="fw-bold">📂 Gelen Analiz Dosyaları</h2>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info p-4 text-center">
            <h4>Henüz Başvuru Yok 😔</h4>
            <p>Analistler henüz bu maç için dosya yüklememiş.</p>
            <a href="/Talep/Taleplerim" class="btn btn-outline-dark">Geri Dön</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var analist = _context.AnalizciProfils.Find(item.AnalizciID);
                string analistAdi = analist != null ? analist.Ad + " " + analist.Soyad : "Bilinmeyen Analist";

                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">
                                <i class="bi bi-person-circle"></i> @analistAdi
                            </span>
                            <small class="text-muted">@item.Tarih.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>

                        <div class="card-body">
                            <h6 class="text-muted small">Analist Notu:</h6>
                            <p class="card-text fst-italic bg-light p-2 rounded">
                                "@(string.IsNullOrEmpty(item.AnalistNotu) ? "Not girilmemiş." : item.AnalistNotu)"
                            </p>

                            <hr />

                            <div class="d-flex flex-column gap-2">

                                <a href="/raporlar/@item.DosyaYolu" target="_blank" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-file-earmark-pdf"></i> PDF'i İncele
                                </a>

                                @if (item.Durum == 1)
                                {
                                    <div class="alert alert-success d-flex justify-content-center align-items-center m-0 p-2">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        <strong>Onaylandı</strong>
                                    </div>
                                }
                                else
                                {
                                    <a href="/Basvuru/Onayla/@item.BasvuruID" class="btn btn-success fw-bold w-100">
                                        ✅ Onayla
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4">
            <a href="/Talep/Taleplerim" class="btn btn-secondary">← Listeye Dön</a>
        </div>
    }
</div>