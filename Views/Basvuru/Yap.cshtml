@model FutbolAnalizPazari.Models.Basvurular

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3>📂 Analiz Yükle</h3>
            <p class="mb-0">Maç: <strong>@(ViewBag.MacBilgisi ?? "Maç Bilgisi Yükleniyor...")</strong></p>
        </div>
        <div class="card-body">

            <form method="post" enctype="multipart/form-data" asp-action="Yap">

                <input type="hidden" name="RaporID" value="@(ViewBag.RaporID ?? Context.Request.RouteValues["id"])" />

                <div class="mb-3">
                    <label class="fw-bold">Analiz Dosyası (PDF)</label>
                    <input type="file" name="dosya" class="form-control" accept=".pdf" required>
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Takıma Notunuz (Opsiyonel)</label>
                    <textarea class="form-control" name="AnalistNotu" rows="3" placeholder="Notunuz..."></textarea>
                </div>

                <button type="submit" class="btn btn-success w-100">🚀 Gönder ve Başvur</button>
            </form>
        </div>
    </div>
</div>