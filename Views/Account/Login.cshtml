@{
    ViewData["Title"] = "Giriş Yap";
}

<style>
    /* TEMEL AYARLAR */
    footer {
        display: none !important;
    }

    body {
        background-color: #060b1e;
        overflow-x: hidden;
    }

    /* ARKA PLAN */
    .login-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(rgba(6, 11, 30, 0.8), rgba(0, 0, 0, 0.9)), url('https://images.unsplash.com/photo-1517466787929-bc90951d0974?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        z-index: -1;
    }

    /* CAM KART */
    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 40px;
        color: white;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    }

    /* INPUTLAR */
    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white !important;
        border-radius: 10px;
        padding: 12px;
    }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.2);
            border-color: #0d6efd;
            box-shadow: 0 0 15px rgba(13, 110, 253, 0.5);
        }

    /* CHECKBOX ÖZELLEŞTİRME */
    .form-check-input {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

    /* BUTON */
    .btn-login {
        background: linear-gradient(90deg, #0d6efd, #0dcaf0);
        border: none;
        color: white;
        padding: 12px;
        border-radius: 10px;
        font-weight: bold;
        transition: transform 0.2s;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(13, 110, 253, 0.4);
        }
</style>

<div class="login-bg"></div>

<div class="container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="col-md-6 col-lg-4">
        <div class="glass-card text-center">

            <div class="mb-4">
                <i class="bi bi-person-circle display-4 text-primary"></i>
                <h2 class="fw-bold mt-3">Giriş Yap</h2>
                <p class="text-white-50 small">Hesabınıza erişmek için bilgilerinizi girin.</p>
            </div>

            @if (TempData["Hata"] != null)
            {
                <div class="alert alert-danger py-2 mb-3 bg-danger bg-opacity-25 border-0 text-white">
                    <i class="bi bi-exclamation-circle me-2"></i> @TempData["Hata"]
                </div>
            }

            <form method="post">
                <div class="mb-3 text-start">
                    <label class="small text-white-50 ms-1 mb-1">E-Mail</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary text-primary"><i class="bi bi-envelope"></i></span>
                        <input type="email" name="mail" class="form-control border-start-0 ps-0" placeholder="mail@ornek.com" required>
                    </div>
                </div>

                <div class="mb-3 text-start">
                    <label class="small text-white-50 ms-1 mb-1">Şifre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary text-primary"><i class="bi bi-lock"></i></span>
                        <input type="password" name="sifre" class="form-control border-start-0 ps-0" placeholder="******" required>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="beniHatirla" value="true" id="rememberMe">
                        <label class="form-check-label text-white-50 small user-select-none" for="rememberMe">
                            Beni Hatırla
                        </label>
                    </div>
                    <a href="/Account/SifremiUnuttum" class="text-primary small text-decoration-none hover-link">Şifremi Unuttum?</a>
                </div>

                <button type="submit" class="btn btn-login w-100 mb-3">
                    GİRİŞ YAP <i class="bi bi-box-arrow-in-right ms-2"></i>
                </button>

                <div class="text-white-50 small">
                    Hesabın yok mu? <a href="/Account/RegisterSecim" class="text-info text-decoration-none fw-bold">Kayıt Ol</a>
                </div>
            </form>
        </div>
    </div>
</div>