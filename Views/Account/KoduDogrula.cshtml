@{
    ViewData["Title"] = "Kodu Doğrula";
}

<style>
    footer {
        display: none !important;
    }

    body {
        background-color: #060b1e;
        overflow-x: hidden;
    }

    .login-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(rgba(6, 11, 30, 0.8), rgba(0, 0, 0, 0.9)), url('https://images.unsplash.com/photo-1517927033932-b3d18e61fb3a?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        z-index: -1;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 40px;
        color: white;
        max-width: 450px;
        width: 100%;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white !important;
        border-radius: 10px;
        padding: 12px;
        text-align: center;
        letter-spacing: 5px;
        font-size: 1.5rem;
        font-weight: bold;
    }
</style>

<div class="login-bg"></div>

<div class="container d-flex align-items-center justify-content-center min-vh-100" style="margin-top: -30px;">
    <div class="glass-card text-center">

        <div class="mb-4">
            <i class="bi bi-shield-lock display-4 text-info"></i>
            <h2 class="fw-bold mt-3">Kodu Doğrula</h2>
            <p class="text-white-50 small">Mail adresinize gönderilen 6 haneli kodu girin.</p>
        </div>

        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger py-2">@TempData["Hata"]</div>
        }

        <form method="post">
            <div class="mb-4">
                <input type="text" name="girilenKod" class="form-control" placeholder="123456" maxlength="6" required>
            </div>

            <button type="submit" class="btn btn-info w-100 fw-bold text-white mb-3">DOĞRULA</button>
            <a href="/Account/SifremiUnuttum" class="text-white-50 small text-decoration-none">Kodu Tekrar Gönder</a>
        </form>
    </div>
</div>