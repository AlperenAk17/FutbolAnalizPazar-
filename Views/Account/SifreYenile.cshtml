@{
    ViewData["Title"] = "Şifre Yenile";
}

<style>
    footer {
        display: none !important;
    }

    body {
        background-color: #060b1e;
        overflow-x: hidden;
    }

    .login-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(rgba(6, 11, 30, 0.8), rgba(0, 0, 0, 0.9)), url('https://images.unsplash.com/photo-1517927033932-b3d18e61fb3a?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        z-index: -1;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 40px;
        color: white;
        max-width: 450px;
        width: 100%;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white !important;
        border-radius: 10px;
        padding: 12px;
    }
</style>

<div class="login-bg"></div>

<div class="container d-flex align-items-center justify-content-center min-vh-100" style="margin-top: -30px;">
    <div class="glass-card text-center">

        <div class="mb-4">
            <i class="bi bi-key-fill display-4 text-success"></i>
            <h2 class="fw-bold mt-3">Yeni Şifre Belirle</h2>
            <p class="text-white-50 small">Lütfen yeni şifrenizi giriniz.</p>
        </div>

        <form method="post">
            <div class="mb-4 text-start">
                <label class="small text-white-50 ms-1 mb-1">Yeni Şifre</label>
                <input type="text" name="yeniSifre" class="form-control" placeholder="******" required>
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold">ŞİFREYİ GÜNCELLE</button>
        </form>
    </div>
</div>