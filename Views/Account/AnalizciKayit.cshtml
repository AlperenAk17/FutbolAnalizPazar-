@{
    ViewData["Title"] = "Analist Kaydı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Footer'ı gizle */
    footer {
        display: none !important;
    }

    body {
        overflow-x: hidden;
    }

    /* ARKA PLAN (TEKNOLOJİ VE ANALİZ) */
    .register-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* YENİ GÖRSEL: Laptopta futbol analizi, karanlık ortam */
        background: linear-gradient(rgba(6, 11, 40, 0.85), rgba(0, 0, 0, 0.95)), url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1920&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        z-index: -1;
    }

    /* BUZLU CAM KART */
    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 25px;
        padding: 40px;
        color: white;
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    }

    /* FORM ELEMANLARI */
    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 8px;
        color: rgba(255,255,255,0.8);
    }

    .form-control, .form-select, .form-control textarea {
        background: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: white !important;
        border-radius: 12px;
        padding: 12px 15px;
    }

        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.15) !important;
            border-color: #0d6efd !important; /* Mavi odak rengi */
            box-shadow: 0 0 15px rgba(13, 110, 253, 0.4) !important;
        }

        .form-control::placeholder {
            color: rgba(255,255,255,0.4);
        }

    /* BUTON */
    .btn-register {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0); /* Analist için Mavi tonları */
        border: none;
        color: white;
        padding: 15px;
        border-radius: 12px;
        font-weight: 800;
        letter-spacing: 1px;
        transition: all 0.3s;
    }

        .btn-register:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(13, 110, 253, 0.5);
        }
</style>

<div class="register-bg"></div>

<div class="container d-flex align-items-center justify-content-center min-vh-100 py-5" style="margin-top: 40px;">
    <div class="col-lg-6 col-md-8">
        <div class="glass-card">

            <div class="text-center mb-4">
                <i class="bi bi-graph-up-arrow display-4 text-primary"></i>
                <h2 class="fw-bold mt-3">Analist Profili Oluştur</h2>
                <p class="text-white-50">Yeteneklerinizi sergileyin, takımlarla buluşun.</p>
            </div>

            <form method="post" action="/Account/AnalizciKayit">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Adınız</label>
                        <input type="text" name="Ad" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Soyadınız</label>
                        <input type="text" name="Soyad" class="form-control" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label"><i class="bi bi-envelope-fill me-2"></i>E-Mail Adresi</label>
                        <input type="email" name="Mail" class="form-control" placeholder="mail@ornek.com" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label"><i class="bi bi-telephone-fill me-2"></i>Telefon No</label>
                        <input type="tel" name="Telefon" class="form-control" placeholder="0555 555 55 55" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"><i class="bi bi-mortarboard-fill me-2"></i>Uzmanlık Alanı</label>
                        <select name="UzmanlikAlan" class="form-select" required>
                            <option value="" selected disabled>Seçiniz...</option>
                            <option value="Maç Analizi">Maç Analizi</option>
                            <option value="Oyuncu Scouting">Oyuncu Scouting (İzleme)</option>
                            <option value="Veri Analizi">Veri Analizi (Data)</option>
                            <option value="Rakip Analizi">Rakip Analizi</option>
                            <option value="Kaleci Analizi">Kaleci Analizi</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Deneyim Süresi</label>
                        <select name="DeneyimYili" class="form-select" required>
                            <option value="0-1 Yıl">0-1 Yıl (Başlangıç)</option>
                            <option value="1-3 Yıl">1-3 Yıl (Orta Seviye)</option>
                            <option value="3-5 Yıl">3-5 Yıl (Deneyimli)</option>
                            <option value="5+ Yıl">5+ Yıl (Uzman)</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Kendinizden Kısaca Bahsedin</label>
                        <textarea name="Hakkinda" class="form-control" rows="3" placeholder="Kullandığınız programlar, geçmiş tecrübeleriniz vb."></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label"><i class="bi bi-lock-fill me-2"></i>Şifre Belirle</label>
                        <input type="password" name="Sifre" class="form-control" placeholder="******" required>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-register w-100">
                        PROFİLİ OLUŞTUR <i class="bi bi-arrow-right-short ms-2"></i>
                    </button>
                </div>
            </form>

            <div class="text-center mt-4 text-white-50 small">
                Zaten hesabınız var mı? <a href="/Account/Login" class="text-primary fw-bold text-decoration-none">Giriş Yap</a>
            </div>
        </div>
    </div>
</div>