@model FutbolAnalizPazari.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Analist Paneli";
}

<style>
    body {
        background-color: #f8fafc;
    }
    /* Çok açık gri/mavi tonu */

    /* İstatistik Kartları */
    .stat-card {
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        transition: 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            border-color: #cbd5e1;
        }

    /* İş İlanı Kartları */
    .job-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        padding: 24px;
        transition: 0.3s;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .job-card:hover {
            border-color: #22c55e;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }

    /* Takım Logosu Yerine Baş Harf Yuvarlağı */
    .team-avatar {
        width: 48px;
        height: 48px;
        background: #f1f5f9;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #475569;
        font-size: 20px;
    }

    .badge-soft-success {
        background-color: #dcfce7;
        color: #166534;
    }

    .badge-soft-warning {
        background-color: #fef9c3;
        color: #854d0e;
    }
</style>

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold text-dark m-0">Hoş geldin, @(Model.Analist?.Ad ?? "Analist") 👋</h2>
            <p class="text-muted m-0">Bugün analiz yapmak için harika bir gün!</p>
        </div>
        <div class="text-end d-none d-md-block">
            <span class="badge bg-white text-dark border shadow-sm p-2 px-3 rounded-pill">
                📅 @DateTime.Now.ToString("dd MMMM yyyy")
            </span>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="stat-card d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                    <i class="bi bi-layers-fill fs-3"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 small fw-bold text-uppercase">Toplam Analiz</p>
                    <h3 class="fw-bold m-0">@Model.Analist?.YaptigiAnalizSay</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 me-3">
                    <i class="bi bi-star-fill fs-3"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 small fw-bold text-uppercase">Ortalama Puan</p>
                    <h3 class="fw-bold m-0">
                        @(Model.Analist?.AnalizPuan != null ? Model.Analist.AnalizPuan.Value.ToString("0.0") : "0.0")
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card d-flex align-items-center">
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-3 me-3">
                    <i class="bi bi-hourglass-top fs-3"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 small fw-bold text-uppercase">Onay Bekleyen</p>
                    <h3 class="fw-bold m-0">@Model.BekleyenIsSayisi</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold"><i class="bi bi-fire text-danger"></i> Fırsat Analizler</h4>
        <a href="#" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">Tümünü Gör</a>
    </div>

    @if (Model.IsFirsatlari.Count == 0)
    {
        <div class="alert alert-light text-center border py-5 rounded-4">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="mt-3 text-muted">Şu an açıkta iş ilanı bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var isFirsati in Model.IsFirsatlari)
            {
                <div class="col-md-4">
                    <div class="job-card">
                        <div class="d-flex align-items-center mb-4">
                            <div class="team-avatar me-3 shadow-sm">
                                @(string.IsNullOrEmpty(isFirsati.TakimAdi) ? "?" : isFirsati.TakimAdi.Substring(0, 1))
                            </div>
                            <div>
                                <h6 class="fw-bold m-0 text-dark">@isFirsati.TakimAdi</h6>
                                <span class="badge bg-light text-muted border rounded-pill mt-1" style="font-size: 11px;">@isFirsati.Lig</span>
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 text-truncate">@isFirsati.MacBilgisi</h5>

                        <div class="d-flex align-items-center text-muted small mb-4">
                            <i class="bi bi-calendar-check me-2"></i>
                            <span>Son Teslim: <strong class="text-dark">@isFirsati.SonTarih.ToString("dd MMM yyyy")</strong></span>
                        </div>

                        <div class="mt-auto">
                            <a href="/Talep/Detay/@isFirsati.RaporID" class="btn btn-dark w-100 py-2 rounded-3 fw-bold shadow-sm">
                                İşi İncele
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h4 class="fw-bold mb-3">📂 İşlem Geçmişi</h4>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        @if (Model.GecmisIsler.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-folder2-open display-4 opacity-25"></i>
                <p class="mt-3">Henüz bir analiz yüklemedin.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted small fw-bold text-uppercase">Maç Bilgisi</th>
                            <th class="py-3 text-muted small fw-bold text-uppercase">Yükleme Tarihi</th>
                            <th class="py-3 text-muted small fw-bold text-uppercase">Durum</th>
                            <th class="py-3 text-muted small fw-bold text-uppercase">Puan</th>
                            <th class="text-end pe-4 py-3 text-muted small fw-bold text-uppercase">Dosya</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var islem in Model.GecmisIsler)
                        {
                            <tr>
                                <td class="fw-bold ps-4 text-dark">@islem.MacBilgisi</td>
                                <td class="text-muted small">@islem.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (islem.Durum == 1)
                                    {
                                        <span class="badge badge-soft-success px-3 py-2 rounded-pill border border-success border-opacity-25">
                                            <i class="bi bi-check-circle-fill me-1"></i> Onaylandı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-warning px-3 py-2 rounded-pill border border-warning border-opacity-25">
                                            <i class="bi bi-clock-history me-1"></i> Bekliyor
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (islem.Puan != null)
                                    {
                                        <span class="text-warning fw-bold"><i class="bi bi-star-fill"></i> @islem.Puan</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted opacity-50">-</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/raporlar/@islem.DosyaYolu" target="_blank" class="btn btn-sm btn-light border text-muted">
                                        <i class="bi bi-file-earmark-pdf-fill text-danger"></i> İndir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>