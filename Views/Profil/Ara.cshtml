@model List<FutbolAnalizPazari.Models.AnalizciProfil> // Model ismini kontrol et

@{
    ViewData["Title"] = "Arama Sonuçları";
}

<div class="container mt-5" style="max-width: 800px;">
    <h3 class="fw-bold mb-4">🔍 "@ViewBag.ArananKelime" için sonuçlar</h3>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning text-center p-4">
            <i class="bi bi-emoji-frown display-4"></i>
            <p class="mt-3">Maalesef aradığınız kriterde bir analist bulunamadı.</p>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var user in Model)
            {
                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3">

                    <div class="d-flex align-items-center gap-3">
                        <img src="https://ui-avatars.com/api/?name=@user.Ad+@user.Soyad&background=random&rounded=true"
                             width="50" height="50" alt="Avatar">

                        <div>
                            <h5 class="mb-0 fw-bold">@user.Ad @user.Soyad</h5>
                            <small class="text-muted">@user.CalistigiKulup</small>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="text-warning fw-bold">
                            ★ @(user.AnalizPuan != null ? user.AnalizPuan.Value.ToString("0.0") : "0.0")
                        </span>

                        <a href="/Profil/Goruntule/@user.AnalizciId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Profile Git →
                        </a>
                    </div>

                </div>
            }
        </div>
    }
</div>