@model List<FutbolAnalizPazari.Models.Raporlar>

@{
    ViewData["Title"] = "Taleplerim";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📂 Açtığım Analiz Talepleri</h2>
        <a href="/Talep/Olustur" class="btn btn-warning shadow-sm">
            + Yeni İlan
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">Henüz hiç talep oluşturmadınız.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="bg-light">
                    <tr>
                        <th>Maç Bilgisi</th>
                        <th>Son Tarih</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.MacBilgisi</td>
                            <td>@item.SonTeslimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <span class="badge bg-success">Yayında</span>
                            </td>
                            <td class="text-end">
                                <a href="/Basvuru/Listele/@item.RaporId" class="btn btn-primary btn-sm">
                                    Başvuruları Gör 📂
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>