@model FutbolAnalizPazari.Models.Raporlar

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3>📢 Yeni Analiz Talebi Oluştur</h3>
                </div>
                <div class="card-body">
                    <form method="post">

                        <div class="mb-3">
                            <label class="fw-bold">Maç Bilgisi / Başlık</label>
                            <input type="text" class="form-control" asp-for="MacBilgisi" placeholder="Örn: Turgutluspor - Manisaspor (14.Hafta)" required>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Analiz Türü</label>
                            @Html.DropDownListFor(x => x.KategoriID, (List<SelectListItem>)ViewBag.Kategoriler, "--- Kategori Seçiniz ---", new { @class = "form-select", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Son Teslim Tarihi</label>
                            <input type="datetime-local" class="form-control" asp-for="SonTeslimTarihi" required>
                        </div>

                        <div class="alert alert-info">
                            <small>Analizciler talebinizi "İş Havuzu"nda görecek ve teklif verecektir.</small>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold">İlanı Yayınla 🚀</button>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>